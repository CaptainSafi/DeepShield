# Copy this file to .env and fill in your own values. Never commit .env.

# Server
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ai-detector
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# AI Insight text analysis (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d

# Stripe (optional, only needed for the Pro plan / checkout flow)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:5000/api/stripe/success
STRIPE_CANCEL_URL=http://localhost:5000/api/stripe/cancel

# Usage limits (optional overrides)
FREE_AI_DAILY_LIMIT=5
ANON_FREE_IMAGES=5
ANON_FREE_VIDEOS=1
FREE_USER_DAILY_IMAGES=10
FREE_USER_DAILY_VIDEOS=3
